@@ -208,6 +208,11 @@ class QSATokenToKVPool(HybridLinearKVPool):
         return self.qsa_rope_position_buffer[loc.long()]
 
     def get_qsa_compressed_k_buffer(self, layer_id: int) -> torch.Tensor:
+        # upstream #39893: the indexer reads compressed keys before attention
+        # reads the full KV. With HiCache restored prefixes, the indexer must
+        # wait for the stage-local layer event before reading its keys, or it
+        # selects attention blocks from in-flight (not yet restored) keys.
+        self._wait_for_layer(layer_id)
         return self.qsa_compressed_k_buffer_pool[
             self._transfer_full_attention_id(layer_id)
         ]

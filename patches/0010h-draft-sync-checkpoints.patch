 logger = logging.getLogger(__name__)
 
 
+def _dbg_sync_checkpoint(tag: str) -> None:
+    """0010h: host-sync checkpoint for the eager-draft crash hunt.
+
+    Device-side assert traps abort the process at the next runtime sync before
+    python can raise. Logging the tag BEFORE the sync pins the trapping phase
+    to the last "[dbg-sync] checkpoint" line in the log (a trap shows the tag
+    without its "passed" line); a clean sync raises a full python traceback.
+    """
+    if os.environ.get("SGLANG_DEBUG_EAGER_DRAFT") != "1":
+        return
+    logger.warning("[dbg-sync] checkpoint %s", tag)
+    torch.cuda.synchronize()
+    logger.warning("[dbg-sync] passed %s", tag)
+
